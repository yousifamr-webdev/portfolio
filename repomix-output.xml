        <div><h2 className="text-sm font-semibold uppercase tracking-[0.2em] text-text-muted">Explore</h2><div className="mt-4 grid gap-3">{links.map((link) => <a key={link.href} className="w-fit text-sm text-text-base hover:text-accent" href={link.href}>{link.label}</a>)}</div></div>
        <div><h2 className="text-sm font-semibold uppercase tracking-[0.2em] text-text-muted">Connect</h2><div className="mt-4 flex flex-wrap gap-3"><a aria-label="GitHub" className="text-text-base hover:text-accent" href={portfolioData.identity.github} target="_blank" rel="noreferrer"><GitBranch size={18} /></a><a aria-label="LinkedIn" className="text-text-base hover:text-accent" href={portfolioData.identity.linkedin} target="_blank" rel="noreferrer"><BriefcaseBusiness size={18} /></a><a aria-label="Facebook" className="text-text-base hover:text-accent" href={portfolioData.identity.facebook} target="_blank" rel="noreferrer"><Globe size={18} /></a><a aria-label="Instagram" className="text-text-base hover:text-accent" href={portfolioData.identity.instagram} target="_blank" rel="noreferrer"><Camera size={18} /></a><button aria-label="Copy email address" className="text-text-base hover:text-accent" type="button" onClick={copyEmail}>{isCopied ? <Check size={18} /> : <Copy size={18} />}</button><a aria-label="Email" className="text-text-base hover:text-accent" href={portfolioData.identity.email}><Mail size={18} /></a></div></div>
