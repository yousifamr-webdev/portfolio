import { motion } from 'framer-motion'
import { BriefcaseBusiness, Compass, Terminal } from 'lucide-react'
import { useEffect, useState, type ComponentType } from 'react'
import { usePersona, type Persona } from '../../context/PersonaContext'
import { PersonalLogo } from '../ui/Logo'

interface PersonaOption {
  id: Exclude<Persona, null>
  title: string
  description: string
  Icon: ComponentType<{ size?: number; strokeWidth?: number; 'aria-hidden'?: boolean }>
}

const options: PersonaOption[] = [
  {
    id: 'client',
    title: 'A Potential Client',
    description: 'Looking for high-impact solutions & polish',
    Icon: BriefcaseBusiness,
  },
  {
    id: 'recruiter',
    title: 'A Recruiter',
    description: 'Fast-tracking tech stack, experience & metrics',
    Icon: Terminal,
  },
  {
    id: 'curious',
    title: 'Just Curious',
    description: 'Exploring creative work & interactive demos',
    Icon: Compass,
  },
]

const spring = { type: 'spring' as const, stiffness: 180, damping: 24 }

export default function IntroOverlay() {
  const { selectPersona } = usePersona()
  const [isTransformed, setIsTransformed] = useState(false)

  useEffect(() => {
    const timer = window.setTimeout(() => setIsTransformed(true), 1200)
    return () => window.clearTimeout(timer)
  }, [])

  return (
    <motion.section
      aria-label="Persona selection"
      className="fixed inset-0 z-50 flex items-center justify-center overflow-hidden bg-canvas px-6 text-text-base"
      exit={{ opacity: 0 }}
      initial={{ opacity: 1 }}
      transition={{ duration: 0.45, ease: 'easeInOut' }}
    >
      <motion.div
        className="absolute text-accent"
        layoutId="brand-monogram"
        animate={
          isTransformed
            ? { scale: 1, left: 24, top: 24, x: 0, y: 0 }
            : { scale: 1.5, left: '50%', top: '50%', x: '-50%', y: '-50%' }
        }
        initial={{ scale: 1.5, opacity: 0, left: '50%', top: '50%', x: '-50%', y: '-50%' }}
        transition={{ ...spring, opacity: { duration: 0.8 } }}
      >
        <PersonalLogo aria-label="Personal monogram" className="h-24 w-24 text-accent" />
      </motion.div>

      <motion.div
        className="w-full max-w-5xl text-center"
        initial={{ opacity: 0, y: 24 }}
        animate={{ opacity: isTransformed ? 1 : 0, y: isTransformed ? 0 : 24 }}
        transition={{ ...spring, delay: isTransformed ? 0.05 : 0 }}
      >
        <p className="mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-text-muted">
          Welcome
        </p>
        <h1 className="mb-10 text-3xl font-bold tracking-tight md:text-5xl">
          Before we begin, who is visiting?
        </h1>
        <div className="grid gap-4 text-left md:grid-cols-3">
          {options.map(({ id, title, description, Icon }) => (
            <motion.button
              key={id}
              type="button"
              className="group rounded-2xl border border-border bg-surface p-6 text-text-base shadow-lg transition-colors hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
              whileHover={{ y: -6 }}
              whileTap={{ scale: 0.98 }}
              transition={spring}
              onClick={() => selectPersona(id)}
            >
              <Icon aria-hidden size={28} strokeWidth={1.8} />
              <span className="mt-8 block text-lg font-semibold">{title}</span>
              <span className="mt-2 block text-sm leading-6 text-text-muted">{description}</span>
            </motion.button>
          ))}
        </div>
      </motion.div>
    </motion.section>
  )
}
